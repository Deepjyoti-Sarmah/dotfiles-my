layout {

    focus-ring {
        active-color   "#b89351"
        inactive-color "#21201f"
        urgent-color   "#c96154"
    }

    border {
        active-color   "#b89351"
        inactive-color "#21201f"
        urgent-color   "#c96154"
    }


    tab-indicator {
        active-color   "#b89351"
        inactive-color "#4e422e"
        urgent-color   "#c96154"
    }

    insert-hint {
        color "#b8935180"
    }
}

recent-windows {
    highlight {
        active-color "#b89351"
        urgent-color "#c96154"
    }
}
