{
  "cli_default_open_behavior": "existing_window",
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    }
  },
  "theme": "Gruvbox Dark Hard",
  "gutter": {
    "line_numbers": true,
  },
  "minimap": {
    "show": "never",
  },
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "mode": "build",
        "effort": "medium",
        "model": "opencode/nemotron-3-ultra-free"
      },
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "auto",
        "effort": "low",
        "model": "sonnet"
      },
      "type": "registry"
    },
    "gemini": {
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "low",
        "mode": "read-only",
        "model": "gpt-5.6-luna"
      },
      "type": "registry",
      "env": {},
    },
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "ui_font_size": 18.0,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 18.0,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "icon_theme": "Zed (Default)",
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "soft_wrap": "editor_width",
  "format_on_save": "on",
  "base_keymap": "VSCode",
  "inlay_hints": {
    "enabled": true,
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "fixed",
  },
  "scrollbar": {
    "show": "never",
  },
  "tab_bar": {
    "show": true,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
  },
  "notification_panel": {
    "button": false,
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "project_panel": {
    "button": true,
    "dock": "left",
    "git_status": true,
  },
  "git_panel": {
    "button": true,
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
    "button": false,
  },
  "agent": {
    "dock": "right",
    "button": true,
  },
  "status_bar": {
    "active_language_button": false,
  },
  "terminal": {
    "font_size": 16.0,
    "button": true,
    // "copy_on_select": true,
    "blinking": "on",
    "font_family": "JetBrainsMono Nerd Font Mono",
    "env": {
      //   "EDITOR": "zed --wait"
      // }
    },
    "theme": {
      "mode": "system",
    },
    "telemetry": {
      "diagnostics": false,
      "metrics": false,
    },
    "file_finder": {
      "modal_max_width": "medium",
    },
    "file_types": {
      "Dockerfile": [
        "Dockerfile",
        "Dockerfile.*"
      ],
      "JSON": [
        "json",
        "jsonc",
        "*.code-snippets"
      ],
    },
    "lsp": {
      "biome": {
        "settings": {
          "require_config_file": true,
        },
      },
    },
    // File scan exclusions, hide on the file explorer and search
    "file_scan_exclusions": [
      "**/.git",
      "**/.svn",
      "**/.hg",
      "**/CVS",
      "**/.DS_Store",
      "**/Thumbs.db",
      "**/.classpath",
      "**/.settings",
      // above is default from Zed
      "**/out",
      "**/dist",
      "**/.husky",
      "**/.turbo",
      "**/.vscode-test",
      "**/.vscode",
      "**/.next",
      "**/.storybook",
      "**/.tap",
      "**/.nyc_output",
      "**/report",
      "**/node_modules",
    ],
    // Only show error on tab
    "tabs": {
      "show_diagnostics": "errors",
    },
  },
}
